APP_NAME=CORVAX — The Core Business Platform
APP_VERSION=1.0.0-final-internal
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/corvax.db
SECRET_KEY=replace-with-a-long-random-secret-before-production
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
JWT_ALGORITHM=RS256
JWT_ACTIVE_KID=corvax-rs256-2026-01
# Provide either a mounted private-key path or escaped PEM. Never commit the private key.
JWT_PRIVATE_KEY_PATH=
JWT_PRIVATE_KEY_PEM=
# JSON object mapping kid to public PEM. Example: {"corvax-rs256-2026-01":"-----BEGIN PUBLIC KEY-----\\n..."}
JWT_PUBLIC_KEYS_JSON={}
FIELD_ENCRYPTION_ACTIVE_KID=corvax-field-2026-01
# JSON object mapping kid to URL-safe base64 AES key. Store in a secret manager.
FIELD_ENCRYPTION_KEYS_JSON={}
SEED_DEMO_DATA=true
ALLOW_DATA_RESET=false
AUTO_CREATE_SCHEMA=true
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
FORCE_HTTPS=false
DOCS_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_COUNT=5
MFA_ISSUER=CORVAX Business Platform
ENFORCE_SENSITIVE_ROLE_MFA=false
SENSITIVE_ROLE_CODES=SUPER_ADMIN,CFO,FINANCIAL_CONTROLLER,PRODUCTION_MANAGER,HR_MANAGER
RATE_LIMIT_ENABLED=true
ENABLE_RATE_LIMIT_TESTING=false
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_MINUTE=10
RATE_LIMIT_MRP_PER_MINUTE=1
RATE_LIMIT_WRITE_PER_MINUTE=300
RATE_LIMIT_READ_PER_MINUTE=100
MRP_INLINE_EXECUTION=true
BACKUP_DIR=./data/backups
LOG_LEVEL=INFO
JSON_LOGGING=true
METRICS_ENABLED=true
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# RC12 payroll control
PAYROLL_STRICT_WORKFLOW=false
