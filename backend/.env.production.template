APP_NAME=CORVAX — The Core Business Platform
APP_VERSION=1.0.0-agreement-completion-rc27.4
ENVIRONMENT=production
DATABASE_URL=postgresql://CORVAX_USER:CHANGE_ME@POSTGRES_HOST:5432/CORVAX_DB
SECRET_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS_AND_STORE_IN_SECRET_MANAGER
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
JWT_ALGORITHM=RS256
JWT_ACTIVE_KID=corvax-rs256-production-01
JWT_PRIVATE_KEY_PATH=/run/secrets/corvax_jwt_private.pem
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEYS_JSON={"corvax-rs256-production-01":"REPLACE_WITH_ESCAPED_PUBLIC_PEM"}
FIELD_ENCRYPTION_ACTIVE_KID=corvax-field-production-01
FIELD_ENCRYPTION_KEYS_JSON={"corvax-field-production-01":"REPLACE_WITH_URLSAFE_BASE64_AES_KEY"}
SEED_DEMO_DATA=false
ALLOW_DATA_RESET=false
AUTO_CREATE_SCHEMA=false
ALLOWED_ORIGINS=https://CORVAX_APPLICATION_DOMAIN
TRUSTED_HOSTS=CORVAX_APPLICATION_DOMAIN
FORCE_HTTPS=true
DOCS_ENABLED=false
ENFORCE_SENSITIVE_ROLE_MFA=true
SENSITIVE_ROLE_CODES=SUPER_ADMIN,CFO,FINANCIAL_CONTROLLER,PRODUCTION_MANAGER,HR_MANAGER
RATE_LIMIT_ENABLED=true
ENABLE_RATE_LIMIT_TESTING=false
MRP_INLINE_EXECUTION=false
PAYROLL_STRICT_WORKFLOW=true
BACKUP_DIR=/var/lib/corvax/backups
JSON_LOGGING=true
METRICS_ENABLED=true
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
